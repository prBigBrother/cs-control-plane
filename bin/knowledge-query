#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd -P "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
DEFAULT_BUDGET=3000
GRAPH="${GRAPHIFY_GRAPH:-}"
BUDGET="$DEFAULT_BUDGET"
DFS=0
QUESTION_PARTS=()

usage() {
  cat <<'USAGE'
Usage: knowledge-query [--graph PATH] [--budget N] [--dfs] <question>

Run a graph-first codebase question against the local Graphify knowledge graph.

Defaults:
- graph: GRAPHIFY_GRAPH, ./graphify-out/merged-graph.json,
         control-plane graphify-out/merged-graph.json, then ./graphify-out/graph.json
- budget: 3000

Examples:
  knowledge-query "how does shipper email signup work?"
  knowledge-query --budget 5000 "how is auth connected to signup tracking?"
  knowledge-query --graph /path/to/merged-graph.json "what is affected by createEmailShipper?"
USAGE
}

while [ "$#" -gt 0 ]; do
  case "$1" in
    --help|-h)
      usage
      exit 0
      ;;
    --graph)
      [ "$#" -ge 2 ] || { echo "Error: --graph requires a path" >&2; exit 2; }
      GRAPH="$2"
      shift 2
      ;;
    --budget)
      [ "$#" -ge 2 ] || { echo "Error: --budget requires a number" >&2; exit 2; }
      BUDGET="$2"
      shift 2
      ;;
    --dfs)
      DFS=1
      shift
      ;;
    --)
      shift
      while [ "$#" -gt 0 ]; do
        QUESTION_PARTS+=("$1")
        shift
      done
      ;;
    *)
      QUESTION_PARTS+=("$1")
      shift
      ;;
  esac
done

if [ "${#QUESTION_PARTS[@]}" -eq 0 ]; then
  usage >&2
  exit 2
fi

if [ -z "$GRAPH" ]; then
  for candidate in \
    "$PWD/graphify-out/merged-graph.json" \
    "$ROOT/graphify-out/merged-graph.json" \
    "$PWD/graphify-out/graph.json"; do
    if [ -f "$candidate" ]; then
      GRAPH="$candidate"
      break
    fi
  done
fi

if [ -z "$GRAPH" ] || [ ! -f "$GRAPH" ]; then
  echo "Error: no Graphify graph found." >&2
  echo "Expected graphify-out/merged-graph.json or set GRAPHIFY_GRAPH=/path/to/graph.json." >&2
  echo "From the control plane, build it with: ./.opencode/bin/knowledge-bootstrap --extract --no-cluster --skip-control-docs" >&2
  exit 3
fi

if ! command -v graphify >/dev/null 2>&1; then
  echo "Error: graphify command not found. Install with: uv tool install graphifyy" >&2
  exit 4
fi

QUESTION="${QUESTION_PARTS[*]}"

echo "Graph: $GRAPH"
echo "Question: $QUESTION"
echo

args=(query "$QUESTION" --graph "$GRAPH" --budget "$BUDGET")
if [ "$DFS" -eq 1 ]; then
  args+=(--dfs)
fi

graphify "${args[@]}"
