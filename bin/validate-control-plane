#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd -P "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"

echo "Shell syntax:"
while IFS= read -r script; do
  [ -n "$script" ] || continue
  if ! head -n 1 "$script" | grep -Eq 'bash|sh'; then
    continue
  fi
  bash -n "$script"
  printf '%s\n' "- ${script#"$ROOT"/}"
done < <(find "$ROOT/bin" "$ROOT/lib" "$ROOT/tests" -type f | sort)

echo
echo "Python syntax:"
for script in "$ROOT/bin/agent-audit" "$ROOT/bin/opencode-profiles" "$ROOT/bin/session-brief"; do
  python3 -c 'import pathlib, sys; compile(pathlib.Path(sys.argv[1]).read_text(), sys.argv[1], "exec")' "$script"
  printf '%s\n' "- ${script#"$ROOT"/}"
done

echo
echo "Command docs coverage:"
missing=0
while IFS= read -r command_file; do
  command_name="/$(basename "$command_file" .md)"
  if grep -qF "$command_name" "$ROOT/docs/commands.md"; then
    printf '%s\n' "- $command_name"
  else
    printf 'Missing from docs/commands.md: %s\n' "$command_name" >&2
    missing=1
  fi
done < <(find "$ROOT/.opencode/commands" -maxdepth 1 -type f -name '*.md' | sort)

if [ "$missing" -ne 0 ]; then
  exit 1
fi

echo
echo "Agent audit:"
"$ROOT/bin/agent-audit"

echo
echo "OpenCode profiles:"
"$ROOT/bin/validate-opencode-profiles"

echo
echo "CLI fixtures:"
"$ROOT/tests/control-plane-cli.sh"
