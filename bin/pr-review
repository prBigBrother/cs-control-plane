#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd -P "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"

usage() {
  echo "Usage: pr-review collect [--trim] <pr-url>"
  echo "       pr-review render <context-json> <findings-json>"
  echo "       pr-review skill <pr-url>"
  echo "       pr-review submit --approved <pr-url> <findings-json>"
  echo
  echo "Options:"
  echo "  --trim    Generate a lean packet: truncate PR body, limit comments,"
  echo "            filter non-logic files. Use for quick-pass reviews."
  echo
  echo "Collect discovers repo rules and creates a compact review packet."
  exit "${1:-1}"
}

require_command() {
  local command_name="$1"

  if ! command -v "$command_name" >/dev/null 2>&1; then
    echo "Error: missing required command: $command_name" >&2
    exit 2
  fi
}

parse_pr_url() {
  local url="$1"
  local parsed

  parsed="$(printf '%s\n' "$url" | sed -E 's#^https://github.com/([^/]+/[^/]+)/pull/([0-9]+).*$#\1 \2#')"
  if [ "$parsed" = "$url" ]; then
    echo "Error: expected GitHub PR URL like https://github.com/owner/repo/pull/123" >&2
    exit 3
  fi

  REPO="$(printf '%s\n' "$parsed" | awk '{print $1}')"
  PR_NUMBER="$(printf '%s\n' "$parsed" | awk '{print $2}')"
}

setup() {
  require_command gh
  require_command jq

  if ! gh auth status >/dev/null 2>&1; then
    echo "Error: GitHub CLI is not authenticated" >&2
    exit 4
  fi
}

review_dir_for() {
  local repo_slug

  repo_slug="$(printf '%s\n' "$REPO" | tr '/[:upper:]' '-[:lower:]')"
  printf '%s\n' "$ROOT/tmp/pr-review-$repo_slug-$PR_NUMBER"
}

collect() {
  local pr_url="$1"
  local trim="${2:-false}"
  local out_dir viewer author is_author rules_source

  setup
  parse_pr_url "$pr_url"
  out_dir="$(review_dir_for)"
  mkdir -p "$out_dir"

  gh pr view "$PR_NUMBER" --repo "$REPO" --json \
    url,number,title,state,isDraft,author,body,baseRefName,headRefName,headRepository,headRepositoryOwner,headRefOid,mergeStateStatus,reviewDecision,additions,deletions,changedFiles,commits \
    >"$out_dir/meta.json"
  gh pr diff "$PR_NUMBER" --repo "$REPO" >"$out_dir/diff.patch"
  gh pr view "$PR_NUMBER" --repo "$REPO" --json files --jq '.files' >"$out_dir/files.json"
  gh api "/repos/$REPO/issues/$PR_NUMBER/comments" --paginate --slurp | jq 'flatten' >"$out_dir/issue-comments.json"
  gh api "/repos/$REPO/pulls/$PR_NUMBER/reviews" --paginate --slurp | jq 'flatten' >"$out_dir/reviews.json"
  gh api "/repos/$REPO/pulls/$PR_NUMBER/comments" --paginate --slurp | jq 'flatten' >"$out_dir/review-comments.json"

  viewer="$(gh api user --jq '.login')"
  author="$(jq -r '.author.login // ""' "$out_dir/meta.json")"
  is_author=false
  if [ "$viewer" = "$author" ]; then
    is_author=true
  fi

  # Derive repo slug for skill detection
  local repo_slug
  repo_slug="$(printf '%s\n' "$REPO" | sed 's|citizenshipper/||')"

  jq -n \
    --arg repo "$REPO" \
    --arg repoSlug "$repo_slug" \
    --argjson number "$PR_NUMBER" \
    --arg viewer "$viewer" \
    --argjson isAuthor "$is_author" \
    --slurpfile meta "$out_dir/meta.json" \
    '{repo:$repo, repo_slug:$repoSlug, number:$number, viewer:$viewer, is_author:$isAuthor, pr:($meta[0] | {url,title,state,author,baseRefName,headRefName,headRefOid,reviewDecision,additions,deletions,changedFiles})}' \
    >"$out_dir/context.json"

  rules_source=""
  for candidate in \
    "$ROOT/repos/$repo_slug/.agents.md" \
    "$ROOT/repos/$repo_slug/.claude/claude.md" \
    "$ROOT/repos/$repo_slug/AGENTS.md"; do
    if [ -f "$candidate" ]; then
      rules_source="$candidate"
      break
    fi
  done
  if [ -n "$rules_source" ]; then
    cp "$rules_source" "$out_dir/repo-rules.md"
  else
    printf '%s\n' "No repo-specific rules found; use general correctness and security checks." >"$out_dir/repo-rules.md"
  fi
  jq --arg rules "$rules_source" '. + {rules_source:($rules | if . == "" then null else . end)}' \
    "$out_dir/context.json" >"$out_dir/context.tmp"
  mv "$out_dir/context.tmp" "$out_dir/context.json"

  # Build description section
  local description
  if [ "$trim" = true ]; then
    # Keep only the first 30 lines of the PR body, skip test-plan/checklist sections
    description="$(jq -r '.body // "(empty)"' "$out_dir/meta.json" | head -30)"
    # If the body contains a "## Test plan" or "### Test plan", truncate before it
    description="$(printf '%s\n' "$description" | sed '/^## Test plan$/,$d' | sed '/^### Test plan$/,$d')"
  else
    description="$(jq -r '.body // "(empty)"' "$out_dir/meta.json")"
  fi

  # Build files list
  local files_list
  if [ "$trim" = true ]; then
    # Filter out non-logic files: lockfiles, pure config, generated files
    files_list="$(jq -r '
      [.[] | select(
        (.path | test("\\.(lock|snap|snapshot)$") | not) and
        (.path | test("^package-lock\\.json$") | not) and
        (.path | test("^yarn\\.lock$") | not) and
        (.path | test("^pnpm-lock\\.yaml$") | not) and
        (.path | test("\\.generated\\.") | not)
      )]
      | .[] | "- \(.path) (+\(.additions) -\(.deletions))"
    ' "$out_dir/files.json")"
  else
    files_list="$(jq -r '.[] | "- \(.path) (+\(.additions) -\(.deletions))"' "$out_dir/files.json")"
  fi

  # Build existing comments section
  local comments_section
  if [ "$trim" = true ]; then
    # Limit to most recent 10 comments
    comments_section="$(jq -r '.[-10:]? | .[]? | "- [\(.user.login)] \(.path):\(.line // "?") \(.body | gsub("\n"; " ") | .[0:240])"' "$out_dir/review-comments.json")"
  else
    comments_section="$(jq -r '.[]? | "- [\(.user.login)] \(.path):\(.line // "?") \(.body | gsub("\n"; " ") | .[0:240])"' "$out_dir/review-comments.json")"
  fi

  {
    echo "# Quick PR Review"
    echo
    echo "- PR: [$(jq -r '.title' "$out_dir/meta.json")]($pr_url)"
    echo "- Repository: $REPO"
    echo "- Repo slug: $repo_slug"
    echo "- Number: $PR_NUMBER"
    echo "- Author: $author"
    echo "- Viewer: $viewer"
    echo "- Viewer is PR author: $is_author"
    echo "- State: $(jq -r '.state' "$out_dir/meta.json")"
    echo "- Review decision: $(jq -r '.reviewDecision // "UNKNOWN"' "$out_dir/meta.json")"
    echo "- Changed files: $(jq -r '.changedFiles' "$out_dir/meta.json")"
    echo "- Additions/deletions: +$(jq -r '.additions' "$out_dir/meta.json")/-$(jq -r '.deletions' "$out_dir/meta.json")"
    if [ "$trim" = true ]; then
      echo "- Mode: trim (quick-pass)"
    fi
    echo "- Repo rules: ${rules_source:-none found}"
    echo
    echo "## Description"
    printf '%s\n' "$description"
    echo
    echo "## Files"
    printf '%s\n' "$files_list"
    echo
    echo "## Existing Review Comments"
    if [ -n "$comments_section" ]; then
      printf '%s\n' "$comments_section"
    else
      echo "(none)"
    fi
    echo
    echo "## Review Contract"
    echo "Report only actionable security, correctness, regression, migration, or missing-test defects."
    echo "Skip style, naming, formatting, docs-only, lockfile, and speculative improvements."
    echo "Severities: critical breaks deploy/auth or leaks data; medium is a likely bug/risky migration/test gap; light is an obvious one-line fix."
    echo "Never invent findings. Security findings are critical."
    echo
    echo "## Local Files"
    echo "- Context JSON: $out_dir/context.json"
    echo "- Metadata JSON: $out_dir/meta.json"
    echo "- Files JSON: $out_dir/files.json"
    echo "- Diff patch: $out_dir/diff.patch"
    echo "- Repo rules: $out_dir/repo-rules.md"
    echo "- Findings JSON target: $out_dir/findings.json"
  } >"$out_dir/packet.md"

  printf 'Review input: %s (diff=%s, rules=%s, findings=%s, own_pr=%s)\n' \
    "$out_dir/packet.md" "$out_dir/diff.patch" "$out_dir/repo-rules.md" "$out_dir/findings.json" "$is_author"
}

validate_findings() {
  local findings_file="$1"
  jq -e '
    type == "array" and all(.[];
      (.severity | IN("critical","medium","light")) and
      (.title | type == "string") and (.body | type == "string") and
      ((.path // "") | type == "string") and
      ((.line == null) or (.line | type == "number"))
    )
  ' "$findings_file" >/dev/null || {
    echo "pr-review: invalid findings JSON; expected severity, title, body, optional path/line/suggestion/security" >&2
    exit 5
  }
}

render() {
  local context_file="$1"
  local findings_file="$2"
  [ -f "$context_file" ] || { echo "pr-review: context not found: $context_file" >&2; exit 5; }
  [ -f "$findings_file" ] || { echo "pr-review: findings not found: $findings_file" >&2; exit 5; }
  validate_findings "$findings_file"
  jq -nr --argjson context "$(cat "$context_file")" --argjson findings "$(cat "$findings_file")" '
    def section($severity):
      [$findings[] | select(.severity == $severity)] as $items |
      if ($items|length) == 0 then "" else
        "\n### " + ($severity|ascii_upcase) + " (" + (($items|length)|tostring) + ")\n" +
        ($items | to_entries | map(
          ((.key+1)|tostring) + ". `" + (.value.path // "general") +
          (if .value.line == null then "" else ":" + (.value.line|tostring) end) + "` — **" + .value.title + "**\n   " +
          (.value.body | gsub("\n"; " ")) +
          (if (.value.suggestion // "") == "" then "" else "\n   → " + (.value.suggestion | gsub("\n"; " ")) end)
        ) | join("\n"))
      end;
    ($findings|length) as $total |
    [$findings[] | select(.severity == "critical")]|length as $critical |
    [$findings[] | select(.severity == "medium")]|length as $medium |
    [$findings[] | select(.severity == "light")]|length as $light |
    "## PR Review — #" + ($context.number|tostring) + "\n\n" +
    "**" + $context.repo + "** · " + ($context.pr.changedFiles|tostring) + " files (" +
    "+" + ($context.pr.additions|tostring) + "/-" + ($context.pr.deletions|tostring) + ") · " +
    ($total|tostring) + " findings (" + ($critical|tostring) + " critical, " + ($medium|tostring) + " medium, " + ($light|tostring) + " light)\n" +
    section("critical") + section("medium") + section("light") +
    (if $total == 0 then "\n\nNo blocking issues." else "" end) + "\n\n" + $context.pr.url
  '
}

skill_path() {
  local pr_url="$1"
  parse_pr_url "$pr_url"
  local repo_slug candidate
  repo_slug="$(printf '%s\n' "$REPO" | sed 's|.*/||')"
  for candidate in \
    "$ROOT/repos/$repo_slug/.opencode/skills/pr-review/SKILL.md" \
    "$ROOT/repos/$repo_slug/.claude/skills/pr-review/SKILL.md"; do
    if [ -f "$candidate" ]; then printf '%s\n' "$candidate"; return 0; fi
  done
  echo "pr-review: no deep-review skill for $repo_slug; use /pr-review" >&2
  return 6
}

submit() {
  local pr_url="$1"
  local findings_file="$2"
  local out_dir viewer author is_author event review_body comment_count commit_id review_id

  setup
  parse_pr_url "$pr_url"

  if [ ! -f "$findings_file" ]; then
    echo "Error: findings JSON not found: $findings_file" >&2
    exit 5
  fi
  validate_findings "$findings_file"

  out_dir="$(review_dir_for)"
  mkdir -p "$out_dir"

  gh pr view "$PR_NUMBER" --repo "$REPO" --json author,headRefOid,title,url >"$out_dir/submit-meta.json"
  viewer="$(gh api user --jq '.login')"
  author="$(jq -r '.author.login // ""' "$out_dir/submit-meta.json")"
  is_author=false
  if [ "$viewer" = "$author" ]; then
    is_author=true
  fi

  jq '
    map(
      if (.security == true or (.category // "" | ascii_downcase) == "security")
      then .severity = "critical"
      else .
      end
    )
  ' "$findings_file" >"$out_dir/normalized-findings.json"

  if [ "$is_author" = true ]; then
    echo "Own PR: review not posted; findings: $out_dir/normalized-findings.json"
    exit 0
  fi

  if jq -e 'any(.[]; (.severity // "" | ascii_downcase) == "critical" or (.severity // "" | ascii_downcase) == "medium")' "$out_dir/normalized-findings.json" >/dev/null; then
    event="REQUEST_CHANGES"
  else
    event="APPROVE"
  fi

  commit_id="$(jq -r '.headRefOid' "$out_dir/submit-meta.json")"

  # Build review body (summary shown in the review header)
  # Keep it conversational — don't duplicate inline comment titles
  review_body="$(
    jq -r '
      if length == 0 then
        "No blocking issues found."
      elif length == 1 then
        "Found 1 issue that needs attention. See inline comment for details."
      else
        "Found " + (length | tostring) + " issues that need attention. See inline comments for details."
      end
    ' "$out_dir/normalized-findings.json"
  )"

  # Build comment bodies
  # Only use ```suggestion blocks when the suggestion is actual code (short, code-like).
  # Otherwise append as plain text: "**Suggestion:** ..."
  local comments_json
  comments_json="$(
    jq '
      [
        .[]
        | select((.path // "") != "" and (.line // null) != null and (.body // "") != "")
        | {
            path: .path,
            line: .line,
            side: (.side // "RIGHT"),
            body: (
              "**" + ((.severity // "light") | ascii_downcase | ascii_upcase) + ": " + ((.title // "Issue") | tostring) + "**\n\n" +
              (.body | tostring) +
              (if (.suggestion // "") != "" then
                (
                  (.suggestion | tostring) as $s |
                  if ($s | length) < 120 and ($s | test("^[\\s\\S]*[;{}()=<>\\[\\]]")) then
                    "\n\n```suggestion\n" + $s + "\n```"
                  else
                    "\n\n**Suggestion:** " + $s
                  end
                )
              else "" end)
            )
          }
      ]
    ' "$out_dir/normalized-findings.json"
  )"

  # Step 1: Create PENDING review (no event field)
  review_id="$(
    jq -n \
      --arg commit_id "$commit_id" \
      --argjson comments "$comments_json" \
      '{commit_id: $commit_id, comments: $comments}' \
    | gh api -X POST "/repos/$REPO/pulls/$PR_NUMBER/reviews" --input - --jq '.id'
  )"

  if [ -z "$review_id" ]; then
    echo "Error: failed to create pending review" >&2
    exit 6
  fi

  # Step 2: Submit the pending review with the chosen event
  comment_count="$(echo "$comments_json" | jq 'length')"
  gh api -X POST "/repos/$REPO/pulls/$PR_NUMBER/reviews/$review_id/events" \
    -f event="$event" \
    -f body="$review_body" >/dev/null

  if [ "$event" = "REQUEST_CHANGES" ]; then
    echo "Requested changes on $REPO#$PR_NUMBER with $comment_count line comment(s)."
  else
    echo "Approved $REPO#$PR_NUMBER with $comment_count line comment(s)."
  fi
}

case "${1:-}" in
  collect)
    shift
    trim=false
    pr_url=""
    while [ "$#" -gt 0 ]; do
      case "$1" in
        --trim) trim=true ;;
        -*) usage ;;
        *) pr_url="$1" ;;
      esac
      shift
    done
    [ -n "$pr_url" ] || usage
    collect "$pr_url" "$trim"
    ;;
  render)
    [ "$#" -eq 3 ] || usage
    render "$2" "$3"
    ;;
  skill)
    [ "$#" -eq 2 ] || usage
    skill_path "$2"
    ;;
  submit)
    if [ "$#" -ne 4 ] || [ "$2" != "--approved" ]; then
      echo "pr-review: submit requires --approved after explicit user approval" >&2
      exit 7
    fi
    submit "$3" "$4"
    ;;
  -h|--help)
    usage 0
    ;;
  *)
    usage
    ;;
esac
