#!/usr/bin/env bash
set -euo pipefail

usage() {
  echo "Usage: compare <service> <environment> [target-sha]"
  echo "  service      daedalus | icarus | odin | olympus"
  echo "  environment  staging | production | prod"
  echo "  target-sha   optional full or partial commit SHA to compare against"
  exit 1
}

[[ $# -lt 2 || $# -gt 3 ]] && usage

SERVICE=$1
ENVIRONMENT_INPUT=$2
TARGET_SHA_INPUT=${3:-}
SCRIPT_DIR="$(cd -P "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"

# shellcheck source=../lib/release-common.sh
source "$ROOT/lib/release-common.sh"

release_require_service "$SERVICE"
ENVIRONMENT=$(release_normalize_compare_environment "$ENVIRONMENT_INPUT")
release_require_initialized_repos "$ROOT" "$SERVICE"
release_fetch_origin "$ROOT" "$SERVICE"

DEPLOYED_SHA=$(release_read_deployed_sha "$ROOT" "$SERVICE" "$ENVIRONMENT")
release_require_commit "$ROOT" "$SERVICE" "deployed" "$DEPLOYED_SHA"

if [ -n "$TARGET_SHA_INPUT" ]; then
  TARGET_SHA=$(release_resolve_target_sha "$ROOT" "$SERVICE" "$TARGET_SHA_INPUT")
  TARGET_LABEL="Target"
else
  TARGET_SHA=$(release_resolve_target_sha "$ROOT" "$SERVICE")
  TARGET_LABEL="origin/main"
fi

DEPLOYED_SHORT=$(release_short_sha "$ROOT" "$SERVICE" "$DEPLOYED_SHA")
TARGET_SHORT=$(release_short_sha "$ROOT" "$SERVICE" "$TARGET_SHA")
REPO_PATH=$(release_repo_path "$ROOT" "$SERVICE")

commit_count() {
  local old_sha=$1
  local new_sha=$2
  git -C "$REPO_PATH" rev-list --count "${old_sha}..${new_sha}"
}

print_summary() {
  echo "## Compare"
  echo
  echo "- Service: \`$SERVICE\`"
  echo "- Environment: \`$ENVIRONMENT\`"
  echo "- Deployed: \`$DEPLOYED_SHA\` (\`$DEPLOYED_SHORT\`)"
  echo "- ${TARGET_LABEL}: \`$TARGET_SHA\` (\`$TARGET_SHORT\`)"
}

print_commit_list() {
  local old_sha=$1
  local new_sha=$2
  release_commit_list "$ROOT" "$SERVICE" "$old_sha" "$new_sha" '- `%h` %s'
}

print_summary
echo ""

if [ "$DEPLOYED_SHA" = "$TARGET_SHA" ]; then
  echo "## Result"
  echo
  echo "- No deployment needed. Deployed and ${TARGET_LABEL} point to the same commit."
  exit 0
fi

if git -C "$REPO_PATH" merge-base --is-ancestor "$DEPLOYED_SHA" "$TARGET_SHA"; then
  count=$(commit_count "$DEPLOYED_SHA" "$TARGET_SHA")
  echo "## Result"
  echo
  echo "- ${TARGET_LABEL} is ahead of deployed by $count commit(s)."
  echo
  echo "## Commits to deploy"
  echo
  print_commit_list "$DEPLOYED_SHA" "$TARGET_SHA"
  exit 0
fi

if git -C "$REPO_PATH" merge-base --is-ancestor "$TARGET_SHA" "$DEPLOYED_SHA"; then
  count=$(commit_count "$TARGET_SHA" "$DEPLOYED_SHA")
  echo "## Result"
  echo ""
  echo "- ${TARGET_LABEL} is behind deployed by $count commit(s)."
  echo
  echo "## Commits already deployed"
  echo
  print_commit_list "$TARGET_SHA" "$DEPLOYED_SHA"
  exit 0
fi

target_only_count=$(commit_count "$DEPLOYED_SHA" "$TARGET_SHA")
deployed_only_count=$(commit_count "$TARGET_SHA" "$DEPLOYED_SHA")

echo "## Result"
echo ""
echo "- Target and deployed histories have diverged."
echo "- ${TARGET_LABEL} has $target_only_count commit(s) not deployed."
echo "- Deployed has $deployed_only_count commit(s) absent from ${TARGET_LABEL}."

echo ""
echo "## Commits in ${TARGET_LABEL} only"
echo
print_commit_list "$DEPLOYED_SHA" "$TARGET_SHA"
echo
echo "## Commits deployed only"
echo
print_commit_list "$TARGET_SHA" "$DEPLOYED_SHA"
