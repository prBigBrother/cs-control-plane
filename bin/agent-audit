#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd -P "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
VERBOSE=0

usage() {
  cat <<'USAGE'
Usage: agent-audit [--verbose]

Audits OpenCode agent and profile token-efficiency guardrails.

Checks:
- agent files have description, scoped mode, permission, and steps
- repeated output-format boilerplate has not returned
- OpenCode JSON profiles parse
- Linear and Datadog MCPs are enabled but hidden globally
- Linear and Datadog specialist agents have explicit MCP tool access
USAGE
}

case "${1:-}" in
  -h|--help)
    usage
    exit 0
    ;;
  --verbose)
    VERBOSE=1
    ;;
  "")
    ;;
  *)
    usage >&2
    exit 2
    ;;
esac

failures=0

fail() {
  printf 'FAIL: %s\n' "$*" >&2
  failures=$((failures + 1))
}

ok() {
  printf 'OK: %s\n' "$*"
}

frontmatter_has() {
  local file="$1"
  local pattern="$2"
  awk '
    NR == 1 && $0 == "---" { in_frontmatter = 1; next }
    in_frontmatter && $0 == "---" { exit }
    in_frontmatter { print }
  ' "$file" | grep -Eq "$pattern"
}

agent_files=()
while IFS= read -r file; do
  agent_files+=("$file")
done < <(find "$ROOT/.opencode/agent-packs" -type f -name '*.md' | sort)

if [ "${#agent_files[@]}" -eq 0 ]; then
  fail "no agent files found under .opencode/agent-packs"
else
  ok "found ${#agent_files[@]} agent files"
fi

agent_words=0
for file in "${agent_files[@]}"; do
  rel="${file#"$ROOT"/}"
  words="$(wc -w < "$file" | tr -d ' ')"
  agent_words=$((agent_words + words))

  frontmatter_has "$file" '^description:' || fail "$rel missing description"
  case "$rel" in
    .opencode/agent-packs/repo/explorer.md)
      frontmatter_has "$file" '^mode: all$' || fail "$rel should use mode all so engineering can default to explorer while manager can delegate to it"
      ;;
    *)
      frontmatter_has "$file" '^mode: (primary|subagent)$' || fail "$rel should use mode primary or subagent"
      ;;
  esac
  frontmatter_has "$file" '^steps:' || fail "$rel missing steps"
  frontmatter_has "$file" '^permission:' || fail "$rel missing permission"

  if grep -qE '^(Output format:|- Write normal Markdown|- Format URLs as Markdown links)' "$file"; then
    fail "$rel has repeated output boilerplate"
  fi

  if [ "$VERBOSE" -eq 1 ]; then
    printf 'agent %-72s %4s words\n' "$rel" "$words"
  fi
done
ok "agent pack word count: $agent_words"

json_files=("$ROOT/opencode.json" "$ROOT/opencode.migration.json")

for file in "${json_files[@]}"; do
  rel="${file#"$ROOT"/}"
  if jq empty "$file" >/dev/null; then
    ok "$rel parses"
  else
    fail "$rel does not parse"
    continue
  fi

  enabled="$(jq -r '.mcp // {} | to_entries[] | select(.value.enabled == true) | .key' "$file" | paste -sd ',' -)"
  [ -n "$enabled" ] || enabled="none"
  [ "$VERBOSE" -eq 0 ] || printf 'profile %-24s enabled_mcp=%s\n' "$rel" "$enabled"
done

for profile in opencode.json opencode.migration.json; do
  file="$ROOT/$profile"
  for key in linear datadog; do
    enabled="$(jq -r --arg key "$key" 'if (.mcp | has($key)) then (.mcp[$key].enabled | tostring) else "missing" end' "$file")"
    if [ "$enabled" != "true" ]; then
      fail "$profile should enable MCP server for per-agent use: $key"
    fi
    tool_enabled="$(jq -r --arg key "${key}_*" 'if (.tools | has($key)) then (.tools[$key] | tostring) else "missing" end' "$file")"
    if [ "$tool_enabled" != "false" ]; then
      fail "$profile should hide MCP tools globally: ${key}_*"
    fi
  done

  for key in jira clauge-workspace; do
    enabled="$(jq -r --arg key "$key" 'if (.mcp | has($key)) then (.mcp[$key].enabled | tostring) else "missing" end' "$file")"
    if [ "$enabled" != "false" ]; then
      fail "$profile should disable global MCP override: $key"
    fi
  done
done

default_agent="$(jq -r '.default_agent // empty' "$ROOT/opencode.json")"
if [ "$default_agent" != "explorer" ]; then
  fail "opencode.json should set default_agent to explorer"
fi

if ! frontmatter_has "$ROOT/.opencode/agent-packs/common/linear-operator.md" '^  linear_\*: true$'; then
  fail "linear-operator should enable linear_* tools"
fi

if ! frontmatter_has "$ROOT/.opencode/agent-packs/common/datadog-investigator.md" '^  datadog_\*: true$'; then
  fail "datadog-investigator should enable datadog_* tools"
fi

if ! frontmatter_has "$ROOT/.opencode/agent-packs/repo/explorer.md" '^    "datadog-investigator": allow$'; then
  fail "explorer should be able to delegate to datadog-investigator"
fi

if ! frontmatter_has "$ROOT/.opencode/agent-packs/repo/explorer.md" '^    "linear-operator": allow$'; then
  fail "explorer should be able to delegate to linear-operator"
fi

if ! frontmatter_has "$ROOT/.opencode/agent-packs/control-plane/manager.md" '^    "datadog-investigator": allow$'; then
  fail "manager should be able to delegate to datadog-investigator"
fi

if ! frontmatter_has "$ROOT/.opencode/agent-packs/control-plane/manager.md" '^    "linear-operator": allow$'; then
  fail "manager should be able to delegate to linear-operator"
fi

if [ "$failures" -ne 0 ]; then
  printf '\n%d audit failure(s)\n' "$failures" >&2
  exit 1
fi

printf '\nAgent audit passed\n'
