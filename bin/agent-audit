#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd -P "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
VERBOSE=0

usage() {
  cat <<'USAGE'
Usage: agent-audit [--verbose]

Audits OpenCode agent and profile token-efficiency guardrails.

Checks:
- agent files have description, scoped mode, permission, and steps
- command files have description frontmatter
- repeated output-format boilerplate has not returned
- OpenCode JSON profiles parse
- control-plane profiles default to Manager and repo profiles default to Explorer
- the built-in Build agent is disabled in every shared profile
- Manager and repo agents handle setup failures before product validation
- Linear and Datadog MCPs are enabled but hidden globally
- Linear and Datadog specialist agents have explicit MCP tool access
USAGE
}

case "${1:-}" in
  -h|--help)
    usage
    exit 0
    ;;
  --verbose)
    VERBOSE=1
    ;;
  "")
    ;;
  *)
    usage >&2
    exit 2
    ;;
esac

failures=0

fail() {
  printf 'FAIL: %s\n' "$*" >&2
  failures=$((failures + 1))
}

ok() {
  printf 'OK: %s\n' "$*"
}

frontmatter_has() {
  local file="$1"
  local pattern="$2"
  awk '
    NR == 1 && $0 == "---" { in_frontmatter = 1; next }
    in_frontmatter && $0 == "---" { exit }
    in_frontmatter { print }
  ' "$file" | grep -Eq "$pattern"
}

frontmatter_field() {
  local file="$1"
  local key="$2"

  awk -v key="$key" '
    NR == 1 && $0 == "---" { in_frontmatter = 1; next }
    in_frontmatter && $0 == "---" { exit }
    in_frontmatter && $0 ~ ("^" key ":[[:space:]]*") {
      sub("^[^:]+:[[:space:]]*", "")
      print
      exit
    }
  ' "$file"
}

agent_files=()
while IFS= read -r file; do
  agent_files+=("$file")
done < <(find "$ROOT/.opencode/agent-packs" -type f -name '*.md' | sort)

if [ "${#agent_files[@]}" -eq 0 ]; then
  fail "no agent files found under .opencode/agent-packs"
else
  ok "found ${#agent_files[@]} agent files"
fi

agent_words=0
for file in "${agent_files[@]}"; do
  rel="${file#"$ROOT"/}"
  words="$(wc -w < "$file" | tr -d ' ')"
  agent_words=$((agent_words + words))

  frontmatter_has "$file" '^description:' || fail "$rel missing description"
  case "$rel" in
    .opencode/agent-packs/repo/explorer.md)
      frontmatter_has "$file" '^mode: all$' || fail "$rel should use mode all so repo profiles can default to explorer while manager can delegate to it"
      ;;
    *)
      frontmatter_has "$file" '^mode: (primary|subagent)$' || fail "$rel should use mode primary or subagent"
      ;;
  esac
  frontmatter_has "$file" '^steps:' || fail "$rel missing steps"
  frontmatter_has "$file" '^permission:' || fail "$rel missing permission"

  min_steps=0
  case "$rel" in
    .opencode/agent-packs/control-plane/manager.md) min_steps=32 ;;
    .opencode/agent-packs/control-plane/control-explorer.md) min_steps=12 ;;
    .opencode/agent-packs/repo/explorer.md) min_steps=12 ;;
    .opencode/agent-packs/repo/implementer.md) min_steps=30 ;;
    .opencode/agent-packs/repo/validator.md) min_steps=16 ;;
  esac

  if [ "$min_steps" -gt 0 ]; then
    steps="$(frontmatter_field "$file" steps)"
    if ! [[ "$steps" =~ ^[0-9]+$ ]]; then
      fail "$rel steps should be numeric"
    elif [ "$steps" -lt "$min_steps" ]; then
      fail "$rel steps should be at least $min_steps"
    fi
  fi

  if grep -qE '^(Output format:|- Write normal Markdown|- Format URLs as Markdown links)' "$file"; then
    fail "$rel has repeated output boilerplate"
  fi

  if [ "$VERBOSE" -eq 1 ]; then
    printf 'agent %-72s %4s words\n' "$rel" "$words"
  fi
done
ok "agent pack word count: $agent_words"

command_files=()
while IFS= read -r file; do
  command_files+=("$file")
done < <(find "$ROOT/.opencode/commands" -maxdepth 1 -type f -name '*.md' | sort)

if [ "${#command_files[@]}" -eq 0 ]; then
  fail "no command files found under .opencode/commands"
else
  ok "found ${#command_files[@]} command files"
fi

for file in "${command_files[@]}"; do
  rel="${file#"$ROOT"/}"
  frontmatter_has "$file" '^description:' || fail "$rel missing description frontmatter"

  if [ "$VERBOSE" -eq 1 ]; then
    printf 'command %-70s %4s words\n' "$rel" "$(wc -w < "$file" | tr -d ' ')"
  fi
done

json_files=(
  "$ROOT/opencode.json"
  "$ROOT/opencode.repo.json"
  "$ROOT/opencode.migration.json"
  "$ROOT/opencode.migration.repo.json"
)

for file in "${json_files[@]}"; do
  rel="${file#"$ROOT"/}"
  if jq empty "$file" >/dev/null; then
    ok "$rel parses"
  else
    fail "$rel does not parse"
    continue
  fi

  enabled="$(jq -r '.mcp // {} | to_entries[] | select(.value.enabled == true) | .key' "$file" | paste -sd ',' -)"
  [ -n "$enabled" ] || enabled="none"
  [ "$VERBOSE" -eq 0 ] || printf 'profile %-24s enabled_mcp=%s\n' "$rel" "$enabled"
done

for profile in opencode.json opencode.repo.json opencode.migration.json opencode.migration.repo.json; do
  file="$ROOT/$profile"
  for key in linear datadog; do
    enabled="$(jq -r --arg key "$key" 'if (.mcp | has($key)) then (.mcp[$key].enabled | tostring) else "missing" end' "$file")"
    if [ "$enabled" != "true" ]; then
      fail "$profile should enable MCP server for per-agent use: $key"
    fi
    tool_enabled="$(jq -r --arg key "${key}_*" 'if (.tools | has($key)) then (.tools[$key] | tostring) else "missing" end' "$file")"
    if [ "$tool_enabled" != "false" ]; then
      fail "$profile should hide MCP tools globally: ${key}_*"
    fi
  done

  for key in jira clauge-workspace; do
    enabled="$(jq -r --arg key "$key" 'if (.mcp | has($key)) then (.mcp[$key].enabled | tostring) else "missing" end' "$file")"
    if [ "$enabled" != "false" ]; then
      fail "$profile should disable global MCP override: $key"
    fi
  done
done

for profile in opencode.json opencode.migration.json; do
  default_agent="$(jq -r '.default_agent // empty' "$ROOT/$profile")"
  if [ "$default_agent" != "manager" ]; then
    fail "$profile should set default_agent to manager"
  fi
done

for profile in opencode.repo.json opencode.migration.repo.json; do
  default_agent="$(jq -r '.default_agent // empty' "$ROOT/$profile")"
  if [ "$default_agent" != "explorer" ]; then
    fail "$profile should set default_agent to explorer"
  fi
done

for profile in opencode.json opencode.repo.json opencode.migration.json opencode.migration.repo.json; do
  build_disabled="$(jq -r '.agent.build.disable // false' "$ROOT/$profile")"
  if [ "$build_disabled" != "true" ]; then
    fail "$profile should disable the built-in Build agent"
  fi
done

if ! frontmatter_has "$ROOT/.opencode/agent-packs/common/linear-operator.md" '^  linear_\*: true$'; then
  fail "linear-operator should enable linear_* tools"
fi

if ! frontmatter_has "$ROOT/.opencode/agent-packs/common/datadog-investigator.md" '^  datadog_\*: true$'; then
  fail "datadog-investigator should enable datadog_* tools"
fi

if ! frontmatter_has "$ROOT/.opencode/agent-packs/repo/explorer.md" '^    "datadog-investigator": allow$'; then
  fail "explorer should be able to delegate to datadog-investigator"
fi

if ! frontmatter_has "$ROOT/.opencode/agent-packs/repo/explorer.md" '^    "linear-operator": allow$'; then
  fail "explorer should be able to delegate to linear-operator"
fi

if ! frontmatter_has "$ROOT/.opencode/agent-packs/control-plane/manager.md" '^    "datadog-investigator": allow$'; then
  fail "manager should be able to delegate to datadog-investigator"
fi

if ! frontmatter_has "$ROOT/.opencode/agent-packs/control-plane/manager.md" '^    "linear-operator": allow$'; then
  fail "manager should be able to delegate to linear-operator"
fi

if ! frontmatter_has "$ROOT/.opencode/agent-packs/control-plane/manager.md" '^    "implementer": allow$'; then
  fail "manager should be able to delegate to implementer without prompting"
fi

if ! grep -qF '/task-start --force-install' "$ROOT/.opencode/agent-packs/control-plane/manager.md"; then
  fail "manager should repair dependency setup with /task-start --force-install"
fi

if ! grep -qF 'step limit' "$ROOT/.opencode/agent-packs/control-plane/manager.md"; then
  fail "manager should continue work when subagents hit step limits"
fi

if ! grep -qF 'Completion Gate:' "$ROOT/.opencode/agent-packs/control-plane/manager.md"; then
  fail "manager should require a Completion Gate in final output"
fi

for file in \
  "$ROOT/.opencode/agent-packs/control-plane/manager.md" \
  "$ROOT/.opencode/agent-packs/control-plane/control-explorer.md" \
  "$ROOT/.opencode/agent-packs/control-plane/auditor.md" \
  "$ROOT/.opencode/agent-packs/control-plane/release.md" \
  "$ROOT/.opencode/agent-packs/repo/explorer.md" \
  "$ROOT/.opencode/agent-packs/repo/implementer.md" \
  "$ROOT/.opencode/agent-packs/repo/validator.md"; do
  rel="${file#"$ROOT"/}"

  has_unrestricted_bash=0
  if grep -qF '    "*": allow' "$file"; then
    has_unrestricted_bash=1
  fi

  if [ "$has_unrestricted_bash" -eq 0 ]; then
    for pattern in \
      '    "git status*": allow' \
      '    "git diff*": allow' \
      '    "git diff *": allow' \
      '    "git log*": allow' \
      '    "git show*": allow' \
      '    "git branch*": allow' \
      '    "git rev-parse*": allow' \
      '    "git ls-files*": allow' \
      '    "npm run lint *": allow' \
      '    "npm run typecheck *": allow' \
      '    "python3 *": allow' \
      '    "gh *": allow' \
      '    "tap-spec *": allow' \
      '    "ts-node *": allow' \
      '    "grep *": allow' \
      '    "rg *": allow' \
      '    "echo *": allow' \
      '    "awk *": allow'; do
      if ! grep -qF "$pattern" "$file"; then
        fail "$rel should allow requested diagnostic shell pattern: $pattern"
      fi
    done

    for broad_pattern in \
      '    "git *": allow' \
      '    "npm *": allow' \
      '    "pnpm *": allow' \
      '    "yarn *": allow' \
      '    "bun *": allow'; do
      if grep -qF "$broad_pattern" "$file"; then
        fail "$rel should not allow broad git/package-manager shell access: $broad_pattern"
      fi
    done
  fi

  if [ "$has_unrestricted_bash" -eq 1 ]; then
    if ! grep -qF 'Bash commands are trusted' "$file"; then
      fail "$rel should document its unrestricted bash policy"
    fi
  elif ! grep -qF 'Avoid chaining commands' "$file"; then
    fail "$rel should tell agents to avoid chained diagnostic commands"
  fi
done

for file in \
  "$ROOT/.opencode/agent-packs/repo/implementer.md" \
  "$ROOT/.opencode/agent-packs/repo/validator.md"; do
  rel="${file#"$ROOT"/}"
  if ! grep -qF '    "*": allow' "$file"; then
    fail "$rel should allow unrestricted bash for friction-free repo workflows"
  fi

  if ! grep -qF 'missing modules' "$file" || ! grep -qF 'setup failures' "$file"; then
    fail "$rel should classify missing dependencies as setup failures"
  fi
done

if [ "$failures" -ne 0 ]; then
  printf '\n%d audit failure(s)\n' "$failures" >&2
  exit 1
fi

printf '\nAgent audit passed\n'
