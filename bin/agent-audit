#!/usr/bin/env python3
"""Deterministic token-efficiency and policy audit for the OpenCode surface."""

from __future__ import annotations

import argparse
import collections
import json
import math
import re
import subprocess
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
AGENT_BUDGET = 2000
COMMAND_BUDGET = 1500
INDIVIDUAL_AGENT_BUDGETS = {"manager.md": 360, "explorer.md": 380}
INDIVIDUAL_COMMAND_BUDGETS = {"pr-review.md": 130, "pr-review-deep.md": 130}
SCRIPT_COMMAND_BUDGET = 85


def words(text: str) -> int:
    return len(re.findall(r"\S+", text))


def frontmatter(text: str) -> tuple[str, str]:
    match = re.match(r"^---\n(.*?)\n---\n?(.*)$", text, re.S)
    return (match.group(1), match.group(2)) if match else ("", text)


def has_field(header: str, field: str) -> bool:
    return re.search(rf"^{re.escape(field)}:", header, re.M) is not None


def audit() -> tuple[dict, list[str]]:
    failures: list[str] = []
    agent_paths = sorted((ROOT / ".opencode" / "agent-packs").glob("**/*.md"))
    command_paths = sorted((ROOT / ".opencode" / "commands").glob("*.md"))
    agent_rows = []
    repeated: dict[str, list[str]] = collections.defaultdict(list)

    for path in agent_paths:
        text = path.read_text()
        header, body = frontmatter(text)
        rel = str(path.relative_to(ROOT))
        count = words(text)
        agent_rows.append({"path": rel, "words": count, "tokens_estimate": math.ceil(count * 4 / 3)})
        for field in ("description", "mode", "steps", "permission"):
            if not has_field(header, field):
                failures.append(f"{rel}: missing {field}")
        mode = re.search(r"^mode:\s*(\S+)", header, re.M)
        expected = {"primary", "subagent", "all"}
        if not mode or mode.group(1) not in expected:
            failures.append(f"{rel}: invalid mode")
        budget = INDIVIDUAL_AGENT_BUDGETS.get(path.name)
        if budget and count > budget:
            failures.append(f"{rel}: {count} words exceeds {budget}")
        if re.search(r"Follow the shared|Agent Output Discipline|^Output:\s*$", body, re.M):
            failures.append(f"{rel}: duplicates shared output policy")
        for line in body.splitlines():
            normalized = re.sub(r"^[-*0-9. ]+", "", line.strip()).lower()
            if len(normalized.split()) >= 7:
                repeated[normalized].append(rel)

    for line, paths in sorted(repeated.items()):
        unique = sorted(set(paths))
        if len(unique) >= 3:
            failures.append(f"repeated agent policy in {len(unique)} files: {line[:90]}")

    agent_total = sum(row["words"] for row in agent_rows)
    if agent_total > AGENT_BUDGET:
        failures.append(f"agent pack: {agent_total} words exceeds {AGENT_BUDGET}")

    command_rows = []
    for path in command_paths:
        text = path.read_text()
        header, body = frontmatter(text)
        rel = str(path.relative_to(ROOT))
        count = words(text)
        script_backed = ".opencode/bin/" in body
        command_rows.append({"path": rel, "words": count, "tokens_estimate": math.ceil(count * 4 / 3), "script_backed": script_backed})
        if not has_field(header, "description"):
            failures.append(f"{rel}: missing description")
        budget = INDIVIDUAL_COMMAND_BUDGETS.get(path.name)
        if budget and count > budget:
            failures.append(f"{rel}: {count} words exceeds {budget}")
        if script_backed:
            if count > SCRIPT_COMMAND_BUDGET:
                failures.append(f"{rel}: script-backed prompt is {count} words; limit {SCRIPT_COMMAND_BUDGET}")
            if len(re.findall(r"^##?\s+Step|^Step\s+[0-9]", body, re.M)):
                failures.append(f"{rel}: duplicates script procedure steps")

    command_total = sum(row["words"] for row in command_rows)
    if command_total > COMMAND_BUDGET:
        failures.append(f"commands: {command_total} words exceeds {COMMAND_BUDGET}")

    profile_check = subprocess.run(
        [str(ROOT / "bin" / "opencode-profiles"), "--check", "--json"],
        text=True,
        capture_output=True,
        check=False,
    )
    try:
        profile_result = json.loads(profile_check.stdout)
    except json.JSONDecodeError:
        profile_result = {"ok": False, "profiles": 0, "drift": ["invalid generator output"]}
    if profile_check.returncode:
        failures.append("OpenCode profiles drift from config/opencode-profiles.json")

    profiles = ["opencode.json", "opencode.repo.json", "opencode.migration.json", "opencode.migration.repo.json"]
    for name in profiles:
        path = ROOT / name
        try:
            data = json.loads(path.read_text())
        except (OSError, json.JSONDecodeError):
            failures.append(f"{name}: invalid JSON")
            continue
        expected_agent = "explorer" if ".repo." in name else "manager"
        if data.get("default_agent") != expected_agent:
            failures.append(f"{name}: default_agent must be {expected_agent}")
        if not data.get("agent", {}).get("build", {}).get("disable"):
            failures.append(f"{name}: built-in build agent must be disabled")
        permission = data.get("permission", {})
        for tool in ("linear_*", "datadog_*"):
            if permission.get(tool) != "deny":
                failures.append(f"{name}: {tool} must be globally denied")
        if not data.get("compaction", {}).get("prune"):
            failures.append(f"{name}: compaction.prune must be enabled")
        if not data.get("tool_output", {}).get("max_lines"):
            failures.append(f"{name}: tool_output limits missing")

    required_text = {
        ".opencode/agent-packs/control-plane/manager.md": ["/task-start --force-install", "step limit", "Completion Gate:", '"implementer": allow'],
        ".opencode/agent-packs/repo/implementer.md": ["setup failures", '"*": allow'],
        ".opencode/agent-packs/repo/validator.md": ["setup failures", '"*": allow'],
        ".opencode/agent-packs/common/linear-operator.md": ["linear_*: allow"],
        ".opencode/agent-packs/common/datadog-investigator.md": ["datadog_*: allow"],
    }
    for rel, needles in required_text.items():
        text = (ROOT / rel).read_text()
        for needle in needles:
            if needle not in text:
                failures.append(f"{rel}: missing required policy: {needle}")

    quick_review = (ROOT / ".opencode/commands/pr-review.md").read_text()
    for needle in ("present that draft", "without explicit user approval"):
        if needle not in quick_review:
            failures.append(f".opencode/commands/pr-review.md: missing approval gate: {needle}")

    metrics = {
        "ok": not failures,
        "agents": {"files": len(agent_rows), "words": agent_total, "tokens_estimate": math.ceil(agent_total * 4 / 3), "budget_words": AGENT_BUDGET, "items": agent_rows},
        "commands": {"files": len(command_rows), "words": command_total, "tokens_estimate": math.ceil(command_total * 4 / 3), "budget_words": COMMAND_BUDGET, "script_budget_words": SCRIPT_COMMAND_BUDGET, "items": command_rows},
        "profiles": profile_result,
        "failures": failures,
    }
    return metrics, failures


def main() -> int:
    parser = argparse.ArgumentParser(description="Audit OpenCode prompts, profiles, and token budgets.")
    parser.add_argument("--json", action="store_true", help="emit machine-readable metrics")
    parser.add_argument("--verbose", action="store_true", help="list per-file metrics")
    args = parser.parse_args()
    metrics, failures = audit()
    if args.json:
        print(json.dumps(metrics, indent=2 if args.verbose else None, separators=None if args.verbose else (",", ":")))
    else:
        agents = metrics["agents"]
        commands = metrics["commands"]
        print(f"Metrics: agents={agents['words']}w/~{agents['tokens_estimate']}t (limit {agents['budget_words']}w) | commands={commands['words']}w/~{commands['tokens_estimate']}t (limit {commands['budget_words']}w)")
        print(f"Profiles: {metrics['profiles'].get('profiles', 0)} {'in sync' if metrics['profiles'].get('ok') else 'drifted'}")
        if args.verbose:
            for group in ("agents", "commands"):
                for item in metrics[group]["items"]:
                    print(f"- {item['path']}: {item['words']}w/~{item['tokens_estimate']}t")
        if failures:
            for failure in failures:
                print(f"FAIL: {failure}", file=sys.stderr)
            print(f"Agent audit failed: {len(failures)} issue(s)", file=sys.stderr)
        else:
            print("Agent audit passed")
    return 1 if failures else 0


if __name__ == "__main__":
    raise SystemExit(main())
