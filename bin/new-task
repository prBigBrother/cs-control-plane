#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd -P "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"

# shellcheck source=../lib/task-common.sh
source "$ROOT/lib/task-common.sh"

link_if_missing() {
  local source_path="$1"
  local target_path="$2"

  if [ -e "$target_path" ] || [ -L "$target_path" ]; then
    return 0
  fi

  mkdir -p "$(dirname "$target_path")"
  ln -s "$source_path" "$target_path"
}

link_globbed_env_files() {
  local source_dir="$1"
  local target_dir="$2"

  [ -d "$source_dir" ] || return 0

  for env_file in "$source_dir"/.env*; do
    [ -f "$env_file" ] || continue
    link_if_missing "$env_file" "$target_dir/$(basename "$env_file")"
  done
}

locks_match() {
  local source_dir="$1"
  local target_dir="$2"

  [ -f "$source_dir/package-lock.json" ] || return 1
  [ -f "$target_dir/package-lock.json" ] || return 1
  cmp -s "$source_dir/package-lock.json" "$target_dir/package-lock.json"
}

ensure_node_modules_link() {
  local source_dir="$1"
  local target_dir="$2"
  local source_path="$source_dir/node_modules"
  local target_path="$target_dir/node_modules"
  local current=""

  if [ ! -d "$source_path" ]; then
    return 1
  fi

  if [ -L "$target_path" ]; then
    current="$(readlink "$target_path")"
    if [ "$current" = "$source_path" ]; then
      return 0
    fi
    rm "$target_path"
  elif [ -e "$target_path" ]; then
    return 1
  fi

  mkdir -p "$target_dir"
  ln -s "$source_path" "$target_path"
}

remove_node_modules_symlink() {
  local target_dir="$1"

  if [ -L "$target_dir/node_modules" ]; then
    rm "$target_dir/node_modules"
  fi
}

prepare_node_dependencies() {
  local source_dir="$1"
  local target_dir="$2"
  local label="$3"

  [ -f "$target_dir/package.json" ] || return 0

  if [ "$INSTALL_DEPS" -eq 0 ]; then
    if locks_match "$source_dir" "$target_dir" && ensure_node_modules_link "$source_dir" "$target_dir"; then
      echo "Linked $label node_modules from base checkout."
    elif [ ! -e "$target_dir/node_modules" ] && [ ! -L "$target_dir/node_modules" ]; then
      echo "Warning: $label node_modules missing and --no-install was passed." >&2
    fi
    return 0
  fi

  if [ ! -f "$target_dir/package-lock.json" ]; then
    if ensure_node_modules_link "$source_dir" "$target_dir"; then
      echo "Linked $label node_modules from base checkout."
    elif [ ! -e "$target_dir/node_modules" ] && [ ! -L "$target_dir/node_modules" ]; then
      echo "Warning: $label has no package-lock.json and no reusable node_modules; skipping dependency install." >&2
    fi
    return 0
  fi

  if [ "$FORCE_INSTALL" -eq 0 ]; then
    if [ -d "$target_dir/node_modules" ] && [ ! -L "$target_dir/node_modules" ]; then
      echo "Using existing local $label node_modules."
      return 0
    fi
  fi

  remove_node_modules_symlink "$target_dir"
  echo "Installing $label dependencies in worktree..."
  npm -C "$target_dir" ci
}

prepare_runtime_assets() {
  local repo_path="$1"
  local worktree_path="$2"
  local package_json package_dir relative_dir source_dir

  # Link repo-level env files such as .env and .env.local, then prepare root deps.
  link_globbed_env_files "$repo_path" "$worktree_path"
  prepare_node_dependencies "$repo_path" "$worktree_path" "$REPO"

  # Link package env files and prepare package-local deps when they have their own lockfile.
  if [ -d "$worktree_path/packages" ]; then
    while IFS= read -r package_json; do
      package_dir="$(dirname "$package_json")"
      relative_dir="${package_dir#"$worktree_path"/}"
      source_dir="$repo_path/$relative_dir"

      link_globbed_env_files "$source_dir" "$package_dir"
      prepare_node_dependencies "$source_dir" "$package_dir" "$REPO/$relative_dir"
    done < <(find "$worktree_path/packages" -mindepth 2 -maxdepth 4 \
      -path "*/node_modules/*" -prune -o \
      -name package.json -print | sort)
  fi
}

run_post_setup() {
  local repo="$1"
  local worktree_path="$2"

  if [ "$repo" != "daedalus" ]; then
    return 0
  fi

  if [ ! -x "$worktree_path/node_modules/.bin/prisma" ]; then
    echo "Warning: $worktree_path/node_modules/.bin/prisma is missing; skipping npm run db:generate." >&2
    return 0
  fi

  echo "Generating Daedalus Prisma clients..."
  (cd "$worktree_path" && npm run db:generate)
}

INSTALL_DEPS=1
FORCE_INSTALL=0
POSITIONAL=()

while [ "$#" -gt 0 ]; do
  case "$1" in
    --no-install)
      INSTALL_DEPS=0
      shift
      ;;
    --force-install)
      FORCE_INSTALL=1
      shift
      ;;
    -h|--help)
      echo "Usage: new-task [--no-install] [--force-install] <repo> <eng-id> [slug] [type]"
      exit 0
      ;;
    --)
      shift
      while [ "$#" -gt 0 ]; do
        POSITIONAL+=("$1")
        shift
      done
      ;;
    -*)
      echo "Unknown option: $1" >&2
      echo "Usage: new-task [--no-install] [--force-install] <repo> <eng-id> [slug] [type]" >&2
      exit 2
      ;;
    *)
      POSITIONAL+=("$1")
      shift
      ;;
  esac
done

if [ "${#POSITIONAL[@]}" -lt 2 ]; then
  echo "Usage: new-task [--no-install] [--force-install] <repo> <eng-id> [slug] [type]" >&2
  exit 1
fi

REPO="${POSITIONAL[0]}"
ENG_ID="${POSITIONAL[1]}"
SLUG="${POSITIONAL[2]:-}"
TYPE="${POSITIONAL[3]:-feature}"
REPO_PATH="$ROOT/repos/$REPO"

case "$SLUG" in
  feature|bug|hotfix|release)
    TYPE="$SLUG"
    SLUG=""
    ;;
esac

if [ -z "$SLUG" ]; then
  resolved_status=0
  resolved_slug="$(resolve_existing_worktree_slug "$ROOT" "$REPO" "$ENG_ID")" || resolved_status=$?

  if [ "$resolved_status" -eq 0 ]; then
    SLUG="$resolved_slug"
  elif [ "$resolved_status" -eq 2 ]; then
    exit 2
  else
    SLUG="task"
  fi
fi

WORKTREE_PATH="$ROOT/worktrees/$REPO/$ENG_ID-$SLUG"
BRANCH="$TYPE/$ENG_ID/$SLUG"

if [ "$REPO" = "dinah" ]; then
  echo "dinah is read-only in this control plane" >&2
  exit 2
fi

if [ ! -e "$REPO_PATH/.git" ]; then
  echo "Repo not initialized: $REPO_PATH" >&2
  exit 3
fi

mkdir -p "$ROOT/worktrees/$REPO"
git -C "$REPO_PATH" fetch origin main:refs/remotes/origin/main
BASE_REF="origin/main"

if [ -f "$WORKTREE_PATH/.git" ] || [ -d "$WORKTREE_PATH/.git" ] || [ -d "$WORKTREE_PATH" ]; then
  prepare_runtime_assets "$REPO_PATH" "$WORKTREE_PATH"
  "$ROOT/bin/install-local-opencode" "$WORKTREE_PATH" engineering repo >/dev/null
  run_post_setup "$REPO" "$WORKTREE_PATH"
  echo "$WORKTREE_PATH"
  exit 0
fi

git -C "$REPO_PATH" worktree add -b "$BRANCH" "$WORKTREE_PATH" "$BASE_REF"

if [ -f "$REPO_PATH/AGENTS.md" ]; then
  cp "$REPO_PATH/AGENTS.md" "$WORKTREE_PATH/AGENTS.md"
fi

prepare_runtime_assets "$REPO_PATH" "$WORKTREE_PATH"

"$ROOT/bin/install-local-opencode" "$WORKTREE_PATH" engineering repo
run_post_setup "$REPO" "$WORKTREE_PATH"

echo "$WORKTREE_PATH"
