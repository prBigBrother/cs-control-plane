#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd -P "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"

if [ "${1:-}" = "--help" ] || [ "${1:-}" = "-h" ]; then
  echo "Usage: validate-opencode-profiles"
  echo "Check generated profiles, JSON syntax, and OpenCode's current local config parser."
  exit 0
fi
[ "$#" -eq 0 ] || { echo "validate-opencode-profiles: no arguments expected" >&2; exit 2; }

"$ROOT/bin/opencode-profiles" --check >/dev/null
for profile in opencode.json opencode.repo.json opencode.migration.json opencode.migration.repo.json; do
  jq empty "$ROOT/$profile"
done

if ! command -v opencode >/dev/null 2>&1; then
  echo "Profiles: JSON/generation valid; OpenCode parser skipped (opencode not installed)"
  exit 0
fi

temp_dir="$(mktemp -d)"
trap 'rm -rf "$temp_dir"' EXIT
for profile in opencode.json opencode.repo.json opencode.migration.json opencode.migration.repo.json; do
  OPENCODE_CONFIG="$ROOT/$profile" \
  OPENCODE_CONFIG_DIR="$ROOT/.opencode" \
    opencode debug config --pure >"$temp_dir/$profile.resolved.json"
  jq -e '.default_agent and .permission and .compaction.prune == true and .tool_output.max_lines' \
    "$temp_dir/$profile.resolved.json" >/dev/null
done
echo "Profiles: 4 accepted by current OpenCode parser"
