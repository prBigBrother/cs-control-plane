{
  "$schema": "https://opencode.ai/config.json",
  "model": "openai/gpt-5.4",
  "small_model": "openai/gpt-5.4-mini",
  "agent": {
    "build": {
      "disable": true
    }
  },
  "mcp": {
    "composio": {
      "type": "remote",
      "url": "https://connect.composio.dev/mcp",
      "enabled": false
    },
    "figma": {
      "type": "remote",
      "url": "https://mcp.figma.com/mcp",
      "enabled": false,
      "oauth": {}
    },
    "jira": {
      "type": "remote",
      "url": "https://mcp.atlassian.com/v1/mcp",
      "enabled": false
    },
    "linear": {
      "type": "remote",
      "url": "https://mcp.linear.app/mcp",
      "enabled": true,
      "oauth": {}
    },
    "slack": {
      "type": "remote",
      "url": "https://mcp.slack.com/mcp",
      "enabled": false,
      "oauth": {
        "clientId": "3660753192626.8903469228982"
      }
    },
    "tavily": {
      "type": "remote",
      "url": "https://mcp.tavily.com/mcp/?tavilyApiKey={env:TAVILY_API_KEY}",
      "enabled": false
    },
    "storyblok": {
      "type": "remote",
      "url": "https://mcp.labs.storyblok.com/mcp",
      "enabled": false,
      "headers": {
        "Authorization": "Bearer {env:STORYBLOK_MCP_TOKEN}"
      }
    },
    "datadog": {
      "type": "remote",
      "url": "https://mcp.datadoghq.com/api/unstable/mcp-server/mcp?toolsets=core,apm",
      "enabled": true,
      "oauth": {}
    },
    "signoz": {
      "type": "remote",
      "url": "http://127.0.0.1:47831/mcp",
      "enabled": true,
      "oauth": false,
      "headers": {
        "SIGNOZ-API-KEY": "{env:SIGNOZ_API_KEY}",
        "X-SigNoz-URL": "{env:SIGNOZ_URL}"
      },
      "timeout": 30000
    },
    "clauge-workspace": {
      "type": "remote",
      "url": "http://localhost:7421/mcp",
      "enabled": false
    }
  },
  "watcher": {
    "ignore": [
      "**/node_modules/**",
      "**/.next/**",
      "**/dist/**",
      "**/coverage/**",
      "**/.git/**",
      "worktrees/**"
    ]
  },
  "tool_output": {
    "max_lines": 800,
    "max_bytes": 40000
  },
  "compaction": {
    "auto": true,
    "prune": true,
    "tail_turns": 2
  },
  "permission": {
    "external_directory": {
      "worktrees": "allow",
      "worktrees/**": "allow"
    },
    "question": "allow",
    "todowrite": "allow",
    "webfetch": "allow",
    "linear_*": "deny",
    "datadog_*": "deny"
  },
  "default_agent": "explorer",
  "instructions": [
    "instructions/shared.md",
    "instructions/engineering.md"
  ]
}
